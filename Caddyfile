{$OUTDO_DOMAIN} {
	encode gzip
	# serveur de jeu (Nakama) : comptes, porte-monnaie, parties
	@api path /v2/* /ws /ws/* /healthcheck
	handle @api {
		reverse_proxy nakama:7350
	}
	# état du serveur (sans secret) : version, conteneurs, journal des mises à jour
	handle /etat.txt {
		root * /srv/etat
		header Cache-Control "no-store"
		file_server
	}
	# version web du jeu (ouvrir le lien sur le téléphone, « Ajouter à l'écran d'accueil »)
	handle {
		root * /srv/web
		header /index.html Cache-Control "no-cache"
		header /main.dart.js Cache-Control "no-cache"
		header /flutter_bootstrap.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
